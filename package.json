{
  "name": "pic-sure-frontend",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "mock-api": "tsx tests/end-to-end/mock-server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node tests/support/check-mock-specifiers.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "clean": "pnpm -s format && pnpm -s lint",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "pnpm -s test:vitest && pnpm -s test:integration",
    "test:vitest": "vitest run",
    "test:unit": "vitest run --project node",
    "test:component": "vitest run --project client",
    "test:integration": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:integration:slim": "playwright test --project chromium --reporter=./tests/support/minimal-reporter.ts --retries=1",
    "playwright": "playwright test --ui",
    "playwright:dev": "PLAYWRIGHT_DEV=1 playwright test --ui",
    "precommit": "vite build && pnpm -s clean && pnpm -s check && pnpm -s test"
  },
  "type": "module",
  "dependencies": {
    "@dnd-kit-svelte/svelte": "^0.1.5",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.2.4",
    "@dnd-kit/helpers": "^0.5.0",
    "@floating-ui/dom": "^1.7.6",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@skeletonlabs/skeleton": "^3.2.0",
    "@skeletonlabs/skeleton-svelte": "^1.5.1",
    "@vincjo/datatables": "^2.8.1",
    "auth0-js": "^10.2.0",
    "driver.js": "^1.4.0",
    "plotly.js-basic-dist-min": "^3.5.1",
    "quill": "^2.0.3",
    "sanitize-html": "^2.17.7",
    "shiki": "^4.4.3",
    "swagger-ui-dist": "^5.33.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/auth0-js": "^9.21.6",
    "@types/node": "24.13.3",
    "@types/plotly.js-basic-dist-min": "^2.12.4",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.71.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "^4.7.5",
    "svelte-eslint-parser": "^1.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
